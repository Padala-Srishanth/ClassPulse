# =============================================================================
# ClassPulse API — Environment Configuration Template
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in every value marked with <...>
#   3. NEVER commit .env or any real credentials to version control
#
# PRODUCTION NOTE:
#   On Google Cloud Run, do NOT use a .env file.
#   Use Cloud Run environment variables + Secret Manager for secrets.
#   The FIREBASE_PRIVATE_KEY should be stored in Secret Manager and
#   mounted as an environment variable at runtime.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
# Options: development | staging | production

APP_NAME=ClassPulse API
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Server (only used by run.py / local dev)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Firebase — Service Account Credentials
#
# SECURITY: These are sensitive service-account credentials.
#   - Development: Place values from your downloaded serviceAccountKey.json
#   - Production:  Use Secret Manager or Cloud Run service identity.
#     Never commit serviceAccountKey.json or a real .env to version control.
#
# How to obtain:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<your-service-account-email>
FIREBASE_PRIVATE_KEY="<your-private-key-including-BEGIN-and-END-lines>"
# Note: The private key contains literal \n characters.
# Wrap the value in double quotes in the .env file.

# ---------------------------------------------------------------------------
# CORS — Allowed Origins
#
# Comma-separated list of allowed origins.
# Development: http://localhost:5173 (Vite default)
# Production:  Your deployed frontend domain(s).
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Production recommendation: INFO

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Set to true in production to suppress internal error details in API responses.
HIDE_ERROR_DETAILS=false
